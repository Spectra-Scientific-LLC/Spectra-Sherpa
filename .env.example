# SpectraSherpa — Environment Configuration
# Copy to .env and adjust as needed.
# Lines starting with # are comments. Uncomment to override defaults.

# =============================================================================
# Application Mode
# =============================================================================
# local    — single-user, no auth, privacy-first (default)
# hybrid   — local processing with optional cloud offload
# enterprise — multi-user, full auth, network egress enabled
APP_MODE=local

# =============================================================================
# Data & Database
# =============================================================================
# Data directory (default: ~/.spectra_sherpa/ when pip-installed, ./data in dev)
# DATA_DIR=

# Database URL (default: SQLite in DATA_DIR)
# DATABASE_URL=sqlite+aiosqlite:///data/spectra_platform.db

# =============================================================================
# Authentication & Security
# =============================================================================
# API key for application access
# APP_API_KEY=default-local-key

# JWT secret — CHANGE THIS in production!
# SECRET_KEY=your-super-secret-key-change-in-production

# Token lifetime in minutes (default: 11520/8 days local, 60 min non-local)
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Enterprise mode: require this password during registration
# ENTERPRISE_PASSWORD=

# =============================================================================
# LLM API Keys (optional — at least one enables AI features)
# =============================================================================
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro

# CUSTOM_LLM_API_KEY=

# =============================================================================
# Network & Egress
# =============================================================================
# Enable outbound network calls (default: false in local, true in hybrid/enterprise)
# EGRESS_ENABLED=false

# Backend API base URL (for frontend config)
# API_BASE_URL=http://localhost:8000

# =============================================================================
# Resource Limits
# =============================================================================
# MAX_SPECTRA_PER_JOB=1000
# MAX_WAVENUMBERS=20000
# MAX_MEMORY_MB=4096
# MAX_FILE_SIZE_MB=200
# MAX_EXPORT_SIZE_MB=1024
# MAX_JOB_DURATION_SEC=3600

# =============================================================================
# Concurrency
# =============================================================================
# MAX_CONCURRENT_JOBS=5
# MAX_CONCURRENT_JOBS_PER_USER=1
# DAG_WORKER_POOL_SIZE=4
# PARALLEL_THRESHOLD=100

# =============================================================================
# Rate Limits
# =============================================================================
# MAX_NIST_DOWNLOADS_PER_HOUR=50
# MAX_LLM_REQUESTS_PER_HOUR=100
# RATE_LIMIT_EXECUTIONS=            # enterprise/hybrid only: max executions/hour/user
# SESSION_EXPIRY_HOURS=             # enterprise/hybrid only

# =============================================================================
# Logging
# =============================================================================
# LOG_BUFFER_SIZE=1000
# LOG_FILE_PATH=                    # e.g. logs/audit.log
# LOG_FILE_MAX_BYTES=10485760       # 10 MB
# LOG_FILE_BACKUP_COUNT=5
# SANITIZE_PATHS=false

# =============================================================================
# Cloud / GPU Offload (hybrid mode)
# =============================================================================
# GRADIENT_API_KEY=
# AUTO_OFFLOAD_THRESHOLD=10000

# =============================================================================
# Reverse Proxy
# =============================================================================
# TRUST_PROXY=false
# TRUSTED_PROXY_CIDRS=

# =============================================================================
# Encryption
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MASTER_ENCRYPTION_KEY=              # Secret used to derive the API-key encryption key

# =============================================================================
# CORS
# =============================================================================
# CORS_ORIGINS=                       # comma-separated allowed origins

# =============================================================================
# System Auth
# =============================================================================
# ALLOW_SYSTEM_API_KEY_AUTH=false     # enable APP_API_KEY auth bypass

# =============================================================================
# Workers
# =============================================================================
# WEB_CONCURRENCY=1                   # uvicorn worker count

# =============================================================================
# SpectroChemPy Data Bootstrap
# =============================================================================
# SCP_DATA_BOOTSTRAP=auto             # auto | required | skip
# SCP_DATA_TIMEOUT=30                 # seconds for SCP data download

# =============================================================================
# Binding
# =============================================================================
# HOST=127.0.0.1                      # bind address

# =============================================================================
# Demo Site Profile (enterprise mode with SITE_PROFILE=demo)
# =============================================================================
# SITE_PROFILE=
# DEMO_MAX_EXECUTIONS=25
# DEMO_MAX_SHERPA_INTERACTIONS=20
# UPGRADE_URL=
