# ============================================================================
# Spectra Scientific Platform - Environment Configuration
# ============================================================================
#
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ============================================================================
# Application Mode
# ============================================================================
# Options: local, hybrid, demo
# - local: Single user on local machine
# - hybrid: Local + cloud GPU offload (requires Gradient AI)
# - demo: Cloud-hosted demo with rate limits
APP_MODE=local

# ============================================================================
# API Configuration
# ============================================================================
API_BASE_URL=http://localhost:8000

# ============================================================================
# CLI Startup Behavior
# ============================================================================
# If true, `spectra-sherpa` will try to free the selected --port before startup
# by terminating processes listening on that port.
# Requires `lsof` (available by default on macOS and most Linux distros).
KILL_PORT_ON_START=false
# Grace period (seconds) after SIGTERM before force-kill
KILL_PORT_GRACE_SECONDS=2.0
# If true, send SIGKILL when process survives the grace period
KILL_PORT_FORCE=true

# ============================================================================
# LLM Provider API Keys
# ============================================================================
# Configure API keys for LLM-powered features (workflow generation, chat assistant)
# Leave blank if not using that provider

# OpenAI (GPT-4, GPT-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude Sonnet 4.5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# DeepSeek (most cost-effective option)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ============================================================================
# Execution Configuration
# ============================================================================
# Options: local, hybrid
EXECUTION_MODE=local

# DigitalOcean Gradient AI (for GPU offload in hybrid mode)
GRADIENT_API_KEY=

# Dataset size threshold for GPU offload (number of samples)
AUTO_OFFLOAD_THRESHOLD=10000

# ============================================================================
# Demo Mode Settings (only used when APP_MODE=demo)
# ============================================================================
# Password for demo access
DEMO_PASSWORD=

# Rate limit: maximum workflow executions per session
RATE_LIMIT_EXECUTIONS=100

# Session expiry in hours
SESSION_EXPIRY_HOURS=24

# ============================================================================
# Data Storage
# ============================================================================
# Directory for uploaded files and workflow data
# pip-installed: defaults to ~/.spectra_sherpa/
# dev checkout: defaults to <repo>/data
DATA_DIR=

# Database URL (SQLite by default)
DATABASE_URL=

# ============================================================================
# Application Security
# ============================================================================
# JWT signing key — MUST be changed for hybrid/demo modes (startup will refuse defaults)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# API key for internal service authentication
APP_API_KEY=default-local-key

# Set to true to accept APP_API_KEY as a valid credential for non-loopback clients
# Only relevant in hybrid/demo modes
ALLOW_SYSTEM_API_KEY_AUTH=false

# Master encryption key for stored API keys (auto-generated if blank, but
# will change on container recreation — set explicitly for persistence)
MASTER_ENCRYPTION_KEY=

# ============================================================================
# Hybrid Mode — SpectraSherpa Server Integration
# ============================================================================
# Per-user API key for identity linking and managed LLM keys.
# Generate via the spectrasherpa-server admin panel: POST /api/v1/admin/users/{id}/rotate-key
# This is NOT the server's APP_API_KEY — each hybrid client gets its own key.
SPECTRASHERPA_API_KEY=
# URL of the spectrasherpa-server (default: https://api.spectrascientific.ai/api/v1)
SPECTRASHERPA_API_URL=

# ============================================================================
# Reverse Proxy (required when behind nginx/Caddy in hybrid/demo)
# ============================================================================
# Trust X-Forwarded-For header from proxy (rate limiting sees real client IP)
TRUST_PROXY=false
# Comma-separated CIDR ranges of trusted proxy peers (e.g., Docker bridge)
TRUSTED_PROXY_CIDRS=

# ============================================================================
# CORS (required for demo/hybrid with a separate frontend domain)
# ============================================================================
# Comma-separated origins, e.g. https://your-domain.com
# Local mode allows all origins by default
CORS_ORIGINS=

# ============================================================================
# Domain (used by Caddyfile for TLS certificate provisioning)
# ============================================================================
DOMAIN=localhost

# ============================================================================
# Resource Limits
# ============================================================================
MAX_SPECTRA_PER_JOB=1000
MAX_WAVENUMBERS=20000
MAX_MEMORY_MB=4096
MAX_CONCURRENT_JOBS=2
MAX_FILE_SIZE_MB=200
MAX_JOB_DURATION_SEC=3600
