# SpectraSherpa — OSS Environment Configuration
# Copy to .env and adjust only the settings you need.
# Lines starting with # are comments.

# =============================================================================
# Local Application
# =============================================================================
# The open-source app runs as a single-user local application by default.
APP_MODE=local

# =============================================================================
# Data & Database
# =============================================================================
# Data directory (default: ~/.spectra_sherpa/ when pip-installed, ./data in dev)
# DATA_DIR=

# Database URL (default: SQLite in DATA_DIR)
# DATABASE_URL=sqlite+aiosqlite:///data/spectra_platform.db

# =============================================================================
# Optional Local Access Key
# =============================================================================
# Optional API key for scripted/local access.
# APP_API_KEY=local-key

# =============================================================================
# Optional BYO Chat Assistant
# =============================================================================
# Enable outbound calls before configuring a chat endpoint.
# EGRESS_ENABLED=true

# Any OpenAI-compatible base URL works. Do not include /chat/completions.
# CHAT_ENDPOINT_URL=https://api.deepseek.com/v1
# CHAT_ENDPOINT_KEY=sk-...
# CHAT_ENDPOINT_MODEL=deepseek-chat

# Local OpenAI-compatible servers such as Ollama, vLLM, or llama.cpp resolve to
# private/loopback addresses. Enable this only when you intentionally point
# CHAT_ENDPOINT_URL at a local endpoint you control.
# SPECTRA_SHERPA_ALLOW_PRIVATE_LLM_ENDPOINTS=true

# =============================================================================
# Network & Egress
# =============================================================================
# Enable outbound network calls for NIST fetches and the BYO chat assistant.
# EGRESS_ENABLED=false

# Backend API base URL (for frontend config)
# API_BASE_URL=http://localhost:8000

# =============================================================================
# Resource Limits
# =============================================================================
# MAX_SPECTRA_PER_JOB=1000
# MAX_WAVENUMBERS=20000
# MAX_MEMORY_MB=4096
# MAX_FILE_SIZE_MB=200
# MAX_EXPORT_SIZE_MB=1024
# MAX_JOB_DURATION_SEC=3600

# =============================================================================
# Concurrency
# =============================================================================
# MAX_CONCURRENT_JOBS=5
# MAX_CONCURRENT_JOBS_PER_USER=1
# DAG_WORKER_POOL_SIZE=4
# PARALLEL_THRESHOLD=100

# =============================================================================
# Rate Limits
# =============================================================================
# MAX_NIST_DOWNLOADS_PER_HOUR=50
# MAX_LLM_REQUESTS_PER_HOUR=100

# =============================================================================
# Logging
# =============================================================================
# LOG_BUFFER_SIZE=1000
# LOG_FILE_PATH=                    # e.g. logs/audit.log
# LOG_FILE_MAX_BYTES=10485760       # 10 MB
# LOG_FILE_BACKUP_COUNT=5
# SANITIZE_PATHS=false

# =============================================================================
# Reverse Proxy
# =============================================================================
# TRUST_PROXY=false
# TRUSTED_PROXY_CIDRS=

# =============================================================================
# Encryption
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MASTER_ENCRYPTION_KEY=              # Secret used to derive the API-key encryption key

# =============================================================================
# CORS
# =============================================================================
# CORS_ORIGINS=                       # comma-separated allowed origins

# =============================================================================
# System Auth
# =============================================================================
# ALLOW_SYSTEM_API_KEY_AUTH=false     # enable APP_API_KEY auth bypass

# =============================================================================
# Workers
# =============================================================================
# WEB_CONCURRENCY=1                   # uvicorn worker count

# =============================================================================
# SpectroChemPy Data Bootstrap
# =============================================================================
# SCP_DATA_BOOTSTRAP=auto             # auto | required | skip
# SCP_DATA_TIMEOUT=30                 # seconds for SCP data download

# =============================================================================
# Binding
# =============================================================================
# HOST=127.0.0.1                      # bind address
# SPECTRA_SHERPA_ALLOW_LOCAL_NETWORK=false
# Set true only if APP_MODE=local is exposed behind another trusted
# access-control layer. Local mode has no login barrier.

# =============================================================================
# Headless Prediction API
# =============================================================================
# HEADLESS_WORKFLOW_ID=
# HEADLESS_API_KEY=                   # required for non-loopback /predict
# SPECTRA_SHERPA_ALLOW_UNAUTHENTICATED_HEADLESS=false
# Set true only when a reverse proxy or other trusted layer authenticates
# callers before they reach the headless prediction app.
