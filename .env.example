# SpectraSherpa — Local Development
# Copy to .env and adjust as needed.

# Application mode: local (default), hybrid, enterprise
APP_MODE=local

# LLM API keys (optional — only needed for AI-powered features)
# At least one key enables workflow generation and the chat assistant.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sherpa Engine uses its own key path (see spectra_sherpa/app/core/config.py).
# If set, powers the server-side Sherpa assistant independently of the
# provider keys above.
# SHERPA_ENGINE_API_KEY=

# Data directory (default: ~/.spectra_sherpa/ when pip-installed, ./data in dev)
# DATA_DIR=

# See .env.enterprise.example for hybrid/enterprise settings.
