# ============================================================================
# SpectraSherpa .gitignore
# ============================================================================

# Environment files (contain secrets - NEVER commit)
.env
.env.local
.env.*
*.env
!.env.example
.envrc

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
dist/
build/

# MkDocs build output
site/
.cache/

# Node
node_modules/
frontend/dist/

# Pre-built frontend SPA (committed to git — DO NOT ignore)
# src/spectra_sherpa/static/ is tracked

# Data / databases (top-level runtime data only — bundled package data is tracked)
/data/
*.db
*.db-wal
*.db-shm
*.sqlite3

# Rate limiter state
rate_limits.json
execution_rate_limits.json

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
__MACOSX/
._*

# IDE
.vscode/
.idea/
.cursor/
.claude/

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.env.e2e

# Generated files
openapi.json
frontend/openapi.json

# Workflow export dumps (generated at runtime)
# Default output dir for export_artifacts(); override via SPECTRA_SHERPA_EXPORT_DIR.
exports/
*_2026*/
*_2025*/
*.zip
# Test-data fixtures are intentionally tracked despite the *.zip rule
# above; allow them explicitly so nothing is tracked-but-ignored by
# accident (the release tooling treats such a mismatch as a fault).
!tests/fixtures/**/*.zip
*.pkl

# uv lock (we use poetry)
uv.lock

# direnv
.envrc

# Linter / type-checker caches
.mypy_cache/
.ruff_cache/

# Vite dev-server cache (local-only, regenerated on every `npm run dev`)
frontend/.vite/

# CLA Assistant local signature cache (generated when the bot posts;
# authoritative signature state lives on the CLA Assistant backend)
signatures/

# Legacy backend/ directory (superseded by src/spectra_sherpa/)
backend/

# Commercial server package (a separate repository — never vendored
# into this tree; guard against an accidental sibling checkout)
spectrasherpa-server/

# SpectroChemPy runtime data (downloaded at runtime, not part of source)
.spectrochempy/

# HITRAN/HAPI2 runtime state (created by local imports/downloads)
.provenance/
config.json
local

# Internal planning docs (top-level only, not src/spectra_sherpa/app/contracts/)
/contracts/

# Local planning drafts under docs/plans/ are working documents, not
# part of the published package (the release tooling rejects this path).
docs/plans/
