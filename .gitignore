# ============================================================================
# SpectraSherpa .gitignore
# ============================================================================

# Environment files (contain secrets - NEVER commit)
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.production

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
dist/
build/

# MkDocs build output
site/

# Node
node_modules/
frontend/dist/

# Pre-built frontend SPA (committed to git — DO NOT ignore)
# src/spectra_sherpa/static/ is tracked

# Data / databases (top-level runtime data only — bundled package data is tracked)
/data/
*.db
*.db-wal
*.db-shm
*.sqlite3

# Rate limiter state
rate_limits.json
execution_rate_limits.json

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.cursor/
.claude/

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Legacy backend/ directory (superseded by src/spectra_sherpa/)
backend/

# Spectrasherpa server (separate paid repo)
spectrasherpa-server/

# SpectroChemPy runtime data (downloaded at runtime, not part of source)
.spectrochempy/

# Internal planning / architecture docs (not for public consumption)
ANALYSIS_REPORT.md
ARCHITECTURE_REFACTOR_PLAN.md
BIG_ROLLBACK_PLAN.md
COMMERCIAL.md
CURRENT.md
DONE.md
FUTURE.md
NODE_ARCHITECTURE_AUDIT.md
NODE_STANDARDIZATION_EFFORT.md
PLS-DA_Implementation_Comparison.md

# Internal docs directories
docs/past/
docs/future/
docs/OSS_SCOPE.md
docs/admin/
docs/deployment/
