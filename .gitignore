# ============================================================================
# SpectraSherpa .gitignore
# ============================================================================

# Environment files (contain secrets - NEVER commit)
.env
.env.local
.env.*.local
.env.*.example
!frontend/e2e/.env.e2e.example
*.env
!.env.example
.envrc

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
dist/
build/

# MkDocs build output
site/

# Node
node_modules/
frontend/dist/

# Pre-built frontend SPA (committed to git — DO NOT ignore)
# src/spectra_sherpa/static/ is tracked

# Data / databases (top-level runtime data only — bundled package data is tracked)
/data/
*.db
*.db-wal
*.db-shm
*.sqlite3

# Rate limiter state
rate_limits.json
execution_rate_limits.json

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.cursor/
.claude/

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.env.e2e

# Generated files
openapi.json
frontend/openapi.json

# Workflow export dumps (generated at runtime)
*_2026*/
*_2025*/
*.zip
*.pkl

# uv lock (we use poetry)
uv.lock

# direnv
.envrc

# Linter / type-checker caches
.mypy_cache/
.ruff_cache/

# Vite dev-server cache (local-only, regenerated on every `npm run dev`)
frontend/.vite/

# CLA Assistant local signature cache (generated when the bot posts;
# OSS/proprietary split: the authoritative signature state lives on the
# CLA Assistant backend, not in the repo)
signatures/

# Legacy backend/ directory (superseded by src/spectra_sherpa/)
backend/

# Spectrasherpa server (separate paid repo)
spectrasherpa-server/

# SpectroChemPy runtime data (downloaded at runtime, not part of source)
.spectrochempy/

# Internal planning docs (top-level only, not src/spectra_sherpa/app/contracts/)
/contracts/

# Internal plan drafts under docs/plans/ — the rest of docs/plans/ is
# public OSS design documentation and should stay tracked.  These two
# files are proprietary / in-progress and live only on the author's
# laptop.
docs/plans/hybrid-1.5-workflow-plan.md
docs/plans/structural-refactor-plan-2026.md
