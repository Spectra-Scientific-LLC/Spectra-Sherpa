      "uri": "spectrasherpa://types/VariableImportance/1.0",
      "category": "array",
      "parent": "Array1D",
      "description": "One producer-owned importance value per input feature"
    },
    "Array2D": {
      "uri": "spectrasherpa://types/Array2D/1.0",
      "category": "array",
      "parent": null,
      "description": "Two-dimensional numeric matrix"
