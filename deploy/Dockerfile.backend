# Build context: .. (repo root)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_VERSION=1.8.3 \
    POETRY_HOME="/opt/poetry" \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1

ENV PATH="$POETRY_HOME/bin:$PATH" \
    PYTHONPATH="/app/src"

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 -

WORKDIR /app

# Copy dependency definition from repo root
COPY pyproject.toml poetry.lock* ./

# Install runtime dependencies only; app source is loaded via PYTHONPATH.
RUN poetry install --only main --no-root && \
    poetry run pip install gunicorn asyncpg

# Copy package source
COPY src/ ./src/

# Create non-root user and data directory
RUN groupadd -r app && useradd -r -g app -s /bin/false app && \
    mkdir -p /app/data && chown -R app:app /app/data

EXPOSE 8000

USER app

# Production: Gunicorn with Uvicorn workers.
# Default to a single worker because WebSocket channel state is in-memory.
CMD ["sh", "-c", "poetry run gunicorn spectra_sherpa.app.main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers ${WEB_CONCURRENCY:-1} --timeout 300 --graceful-timeout 30 --access-logfile -"]
