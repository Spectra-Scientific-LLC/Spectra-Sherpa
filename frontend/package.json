{
  "name": "spectra-sherpa-frontend",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/ --max-warnings 300",
    "check:theme": "node scripts/theme-colors.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test:e2e": "playwright test",
    "test:science": "tsc -p tsconfig.scientific.json && playwright test --config playwright.scientific.config.ts",
    "test:science:smoke": "npm run test:science -- --grep @smoke",
    "test:science:provider": "playwright test --config playwright.provider.config.ts",
    "generate:types": "node scripts/generate-api-types.mjs",
    "generate:types:check": "node scripts/generate-api-types.mjs --check",
    "check:types": "node scripts/generate-api-types.mjs --check"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "@tanstack/vue-query": "^5.105.0",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.20.0",
    "chart.js": "^4.6.1",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "katex": "^0.19.1",
    "lucide-vue-next": "^0.468.0",
    "markdown-it-texmath": "^1.0.0",
    "monaco-editor": "^0.53.0",
    "pinia": "^2.2.8",
    "plotly.js-cartesian-dist-min": "^2.35.0",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-demi": "^0.14.10",
    "vue-markdown-render": "^2.3.1",
    "vue-router": "^4.5.0",
    "vue3-perfect-scrollbar": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/vue": "^8.1.0",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "5.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.8"
  },
  "overrides": {
    "js-cookie": "^3.0.7",
    "js-yaml": "^4.2.0",
    "lodash": "^4.18.0",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.6",
    "glob": "14.0.3",
    "minimatch@>=9": "11.0.3"
  }
}
