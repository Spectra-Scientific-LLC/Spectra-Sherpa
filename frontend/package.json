{
  "name": "spectra-sherpa-frontend",
  "version": "0.5.22",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/ --max-warnings 300",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test:e2e": "playwright test",
    "generate:types": "openapi-typescript contracts/openapi-llm-v1.json -o src/types/api-generated.ts"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "@tanstack/vue-query": "^5.101.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "chart.js": "^4.4.7",
    "d3-scale": "^4.0.2",
    "date-fns": "^4.4.0",
    "katex": "^0.17.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it-texmath": "^1.0.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "plotly.js-cartesian-dist-min": "^3.6.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.38",
    "vue-chartjs": "^5.3.2",
    "vue-demi": "^0.14.10",
    "vue-markdown-render": "^2.3.1",
    "vue-router": "^5.1.0",
    "vue3-perfect-scrollbar": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/vue": "^8.1.0",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "js-cookie": "^3.0.7",
    "lodash": "^4.18.0"
  }
}
